# secrets
.env
.env.*
!.env.example

# videos and large binaries: never commit (repo will be public)
data/raw/
data/edited/
data/proxy/
# recordings sent by the iPhone app, and their manifest rows (local only)
data/uploads/
data/manifest_app.csv
*.mp4
*.mov
*.MP4
*.MOV
*.mkv
*.webm
*.avi

# generated results: only summary.md, PNG charts and checklists are committed
results/*
!results/summary.md
!results/summary_dev.md
!results/summary_dev_audio.md
!results/*.png
!results/checklists/
results/checklists/*
!results/checklists/*.json

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# iOS: generated by xcodegen and xcodebuild
ios/build/
ios/build-device/
ios/*.xcodeproj/
ios/ProcedureReplay/Resources/glasses_feed.json

# README hero video (our own edit; footage credited in README)
!docs/assets/*.mp4
